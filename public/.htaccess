# Hisobla — Apache hosting sozlamalari (cPanel va shunga o'xshash hostinglar uchun)

# Fayl turlari: ba'zi hostinglar ularni bilmaydi
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType image/svg+xml .svg

# index.html va sw.js doim yangisi olinsin — sayt yangilanganda eski versiya qolib ketmaydi
<FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache"
  </IfModule>
</FilesMatch>

# assets/ dagi fayllar nomi har versiyada o'zgaradi — uzoq keshlash xavfsiz
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Siqib yuborish (tezroq ochiladi)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>
